---
<article class="prose">
  <slot />
</article>

<style>
  .prose {
    padding: 1rem;
    background: var(--input-bg);
    color: var(--text-color);
  }
  
  .prose :global(h1) {
    font-size: 1.5rem;
    font-weight: bold;
    margin-bottom: 0.5rem;
    border-bottom: 2px solid var(--border-medium);
    padding-bottom: 0.25rem;
  }
  
  .prose :global(h2) {
    font-size: 1.25rem;
    font-weight: bold;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .prose :global(h3) {
    font-size: 1.1rem;
    font-weight: bold;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .prose :global(p) {
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }
  
  .prose :global(ul) {
    list-style-type: square;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
  }
  
  .prose :global(ol) {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .prose :global(li) {
    margin-bottom: 0.25rem;
  }
  
  .prose :global(blockquote) {
     border-left: 4px solid var(--border-medium);
     padding-left: 1rem;
     margin-left: 0;
     margin-right: 0;
     font-style: italic;
     background-color: var(--surface-light);
     padding-top: 0.5rem;
     padding-bottom: 0.5rem;
  }
  
  .prose :global(a) {
    color: var(--link-color);
    text-decoration: underline;
  }

  .prose :global(code) {
    background-color: var(--surface);
    padding: 0.2em 0.4em;
    font-family: monospace;
    font-size: 0.9em;
  }
  
  .prose :global(pre) {
    background-color: var(--surface-dark);
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
    border: 1px solid var(--border-medium);
  }
  
  .prose :global(pre code) {
    background-color: transparent;
    padding: 0;
    color: white; 
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1rem auto;
    border: 2px solid var(--border-medium);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1rem;
  }
  
  .prose :global(th), .prose :global(td) {
    border: 1px solid var(--border-medium);
    padding: 0.5rem;
    text-align: left;
  }
  
  .prose :global(th) {
    background-color: var(--surface);
    font-weight: bold;
  }
</style>
