---
import {Picture} from 'astro:assets'

interface Props {
  lightSrc: ImageMetadata
  darkSrc: ImageMetadata
  size: number
  [key: string]: any
}

const {lightSrc, darkSrc, size, ...rest } = Astro.props;
---  

<div class="inline-block relative">
  <Picture 
    src={lightSrc} 
    alt="" 
    class:list={"light-icon"}
    width={size} 
    height={size} 
    densities={[1,2]} 
    formats={["avif", "webp"]} 
    {...rest} 
  />
  
  <Picture 
    src={darkSrc} 
    alt="" 
    class:list={"dark-icon"}
    width={size} 
    height={size} 
    densities={[1,2]} 
    formats={["avif", "webp"]} 
    {...rest} 
  />
</div>

<style>
  .light-icon { display: block; }
  .dark-icon { display: none; }

  :global(.dark) .light-icon { display: none; }
  :global(.dark) .dark-icon { display: block; }
</style>