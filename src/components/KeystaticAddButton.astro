---
interface Props {
  collection: string;
}

const { collection } = Astro.props;
const href = `/keystatic/collection/${collection}/create`;
---

<a href={href} class="keystatic-link">
  <button type="button" class="keystatic-btn">Add</button>
</a>

<style>
  .keystatic-link {
    text-decoration: none;
  }

  .keystatic-btn {
    min-width: 32px;
    min-height: 23px;
    padding: 0 8px;
    font-size: 12px;
    cursor: pointer;
  }
</style>
