---
import Icon from './Icon.astro';
import addIcon from '../assets/Icons/Add Icon.png';

interface Props {
  collection: string;
}

const { collection } = Astro.props;
const href = `/keystatic/collection/${collection}/create`;
---

<a href={href} class="keystatic-link" title="Add new entry">
  <button type="button" class="keystatic-btn">
    <Icon src={addIcon} size={14} />
    Add
  </button>
</a>

<style>
  .keystatic-link {
    text-decoration: none;
  }

  .keystatic-btn {
    min-height: 23px;
    padding: 2px 8px;
    font-size: 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
  }
</style>
