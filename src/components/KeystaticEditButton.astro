---
import Icon from './Icon.astro';
import editIcon from '../assets/Icons/Edit Icon.png';

interface Props {
  collection: string;
  itemId: string;
}

const { collection, itemId } = Astro.props;
const href = `/keystatic/collection/${collection}/item/${itemId}`;
---

<a href={href} class="keystatic-link" title="Edit entry">
  <button type="button" class="keystatic-btn">
    <Icon src={editIcon} size={14} />
    Edit
  </button>
</a>

<style>
  .keystatic-link {
    text-decoration: none;
  }

  .keystatic-btn {
    min-height: 23px;
    padding: 2px 8px;
    font-size: 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
  }
</style>
