---
import { getCollection } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import KeystaticAddButton from '../components/KeystaticAddButton.astro';
import AnomaliesListing from '../components/preact/AnomaliesListing';
import AnomalyIcon from '../components/Icons/AnomalyIcon.astro';
import { formatDate } from 'src/utils/time';

const anomalies = await getCollection('anomalies');
const anomaliesData = anomalies.map(anomaly => ({
  id: anomaly.data.id,
  name: anomaly.data.name,
  classification: anomaly.data.classification,
  status: anomaly.data.status,
  discoveryDate: formatDate(anomaly.data.discoveryDate),
  location: anomaly.data.location,
}));
---

<ContentLayout title="Anomalies">
  <KeystaticAddButton slot="title-bar-extra" collection="anomalies" />
  <h1 class="flex items-center justify-between">
    Anomaly Reports
   <AnomalyIcon class="mr-4" size={96} />    
  </h1>

  <AnomaliesListing anomalies={anomaliesData} client:load />
</ContentLayout>

