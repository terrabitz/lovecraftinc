---
import { getCollection } from 'astro:content';
import Card from "../components/Card.astro";
import Table from "../components/Table.astro";
import ContentLayout from "../layouts/ContentLayout.astro";
import ContentTypeIcon from '../components/content-type-icon.astro';
import { contentTypes } from '../content-types';

const totals = await Promise.all(contentTypes.map(async type => ({
  ...type,
  count: (await getCollection(type.slug)).length,
})));

const ICON_SIZE=40;
---

<ContentLayout title="Dashboard">
  <div class="field-border">
    <div class="mt-4 p-3">
      <h1>Welcome to the Eidolon Capital Intranet</h1>
      <p>
        Welcome to the internal information system of Eidolon Capital. This portal provides access to critical
        organizational data, employee records, anomaly reports, and partner organization profiles.
      </p>
      <p>Please use the navigation links above to access different sections of the intranet.</p>
    </div>
  </div>

  <h2 class="mt-3">Quick Access</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 my-3">
    {contentTypes.map(type => (
      <Card title={type.heading}>
        <ContentTypeIcon icon={type.icon} size={ICON_SIZE} slot="icon" />
        <p>{type.description}</p>
        <a href={`/${type.slug}`} slot="bottom">
          <button>View {type.label}</button>
        </a>
      </Card>
    ))}
  </div>

  <hr class="mt-4"/>

  <Table class="mt-3">
    <thead>
      <tr>
        <th>Property</th>
        <th>Value</th>
      </tr>
    </thead>
    <tbody>
      {totals.map(type => (
        <tr>
          <td>Total {type.label}</td>
          <td>{type.count}</td>
        </tr>
      ))}
      <tr>
        <td>Last Update</td>
        <td>1995-04-28</td>
      </tr>
    </tbody>
  </Table>
</ContentLayout>

<style>
  .system-info-table{
    width: 200px;
  }
</style>