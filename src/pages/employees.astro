---
import { getCollection } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import EmployeesListing from '../components/preact/EmployeesListing';
import EmployeeIcon from '../components/Icons/EmployeeIcon.astro';

const employees = await getCollection('employees');
const employeesData = employees.map(emp => ({
  id: emp.data.id,
  name: emp.data.name,
  position: emp.data.position,
  department: emp.data.department,
}));
---

<ContentLayout title="Employees">
  <h1 class="flex items-center justify-between">
    Employee Directory
    <EmployeeIcon class="mr-4" size={96} />
  </h1>

  <EmployeesListing employees={employeesData} client:load />
</ContentLayout>

