---
import { getCollection } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import OrganizationsListing from '../components/preact/OrganizationsListing';
import OrganizationIcon from '../components/Icons/OrganizationIcon.astro';

const organizations = await getCollection('organizations');
const organizationsData = organizations.map(org => ({
  id: org.data.id,
  name: org.data.name,
  type: org.data.type,
  relationship: org.data.relationship,
  established: org.data.established,
  location: org.data.location,
}));
---

<ContentLayout title="Organizations">
  <h1 class="flex items-center justify-between">
    Partner Organizations
    <OrganizationIcon size={96} />
  </h1>

  <OrganizationsListing organizations={organizationsData} client:load />
</ContentLayout>

