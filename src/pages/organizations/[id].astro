---
import { getCollection, render } from 'astro:content';
import Table from '../../components/Table.astro';
import ContentLayout from '../../layouts/ContentLayout.astro';
import KeystaticEditButton from '../../components/KeystaticEditButton.astro';
import OrganizationIcon from '../../components/Icons/OrganizationIcon.astro';
import Article from '../../components/Article.astro';

export async function getStaticPaths() {
  const organizations = await getCollection('organizations');

  return organizations.map((org) => ({
    params: { id: org.data.id.toUpperCase() },
    props: { organization: org }
  }));
}

const { organization } = Astro.props;
const { Content } = await render(organization);
---

<ContentLayout title={`Organization - ${organization.data.name}`}>
  <KeystaticEditButton slot="title-bar-extra" collection="organizations" itemId={organization.data.id} />
  <h2 class="flex items-center justify-between">
    {organization.data.name}
    <OrganizationIcon class="mr-4" size={96} />  
  </h2>

  <Table>
    <tr>
      <td><strong>Organization ID:</strong></td>
      <td>{organization.data.id}</td>
    </tr>
    <tr>
      <td><strong>Type:</strong></td>
      <td>{organization.data.type}</td>
    </tr>
    <tr>
      <td><strong>Relationship:</strong></td>
      <td>{organization.data.relationship}</td>
    </tr>
    <tr>
      <td><strong>Established:</strong></td>
      <td>{organization.data.established}</td>
    </tr>
    <tr>
      <td><strong>Location:</strong></td>
      <td>{organization.data.location}</td>
    </tr>
  </Table>

  <hr class="mt-1">

  <div class="field-border mt-2">
    <Article>
      <Content />
    </Article>
  </div>

  <hr>

  <a href="/organizations">
    <button class="mt-2">← Back to Organizations</button>
  </a>
</ContentLayout>
