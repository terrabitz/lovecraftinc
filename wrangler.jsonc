{
  "main": "dist/_worker.js/index.js",
  "name": "lovecraftinc",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "env": {
    "prod": {
      "name": "lovecraftinc"
    },
    "stage": {
      "name": "lovecraftinc-stage"
    }
  },
  "observability": {
    "enabled": true
  }
}